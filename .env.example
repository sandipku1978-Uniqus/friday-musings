# Copy to .env.local for `npm run dev:live`, and set the same values in Vercel → Settings → Environment Variables.

# Required
ANTHROPIC_API_KEY=sk-ant-...
RECEIPT_SECRET=<random 32+ characters>   # signs receipts and seals paused runs; e.g. `openssl rand -hex 32`

# Recommended before posting the link widely: shared rate-limit counters (Vercel KV / Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional tuning (defaults shown)
# CONCIERGE_MODEL=claude-sonnet-5-5
# CONCIERGE_EFFORT=medium
# CONCIERGE_FALLBACKS=on          # "off" disables server-side refusal fallback
# RUNS_PER_HOUR=6                 # per visitor
# DAILY_RUN_CAP=200               # across all visitors
